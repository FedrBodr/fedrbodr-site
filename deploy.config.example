# --- FTP-доступ к хостингу reg.ru ---
# Скопируй этот файл в deploy.config и впиши свои данные.
# deploy.config в .gitignore — он НЕ попадёт в git. Пароль не коммить.
# Данные берутся в панели reg.ru: раздел «Хостинг» → «FTP-доступ».

FTP_HOST="server52.hosting.reg.ru"  # имя сервера: сертификат FTPS выписан на него, не на IP
FTP_USER='uXXXXXXX'            # FTP-логин из панели (НЕ email от аккаунта!)
FTP_PASS='ПАРОЛЬ'             # FTP-пароль. Одинарные кавычки — спецсимволы ($ ` " \) не сломают
FTP_DIR="/www/fedrbodr.com"    # папка сайта на хостинге (уточни в панели)

FTP_SSL="1"                    # FTPS: пароль и файлы идут в зашифрованном виде
